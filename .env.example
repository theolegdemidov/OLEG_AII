# Все ключи только здесь. Файл .env никому не отправляй.
YOUTUBE_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Ссылка на твой канал для пинов (необязательно), например https://t.me/твой_канал
TELEGRAM_CHANNEL_URL=

# LLM: anthropic или gemini. Анализ видеофайлов (Video Lab) работает только через Gemini.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Пароль для доступа телефона к серверу на ноутбуке. ОБЯЗАТЕЛЕН. Сгенерируй:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=
MAX_UPLOAD_MB=200

# Pinterest (необязательно): только пины-картинки, после явного подтверждения
PINTEREST_ACCESS_TOKEN=
PINTEREST_BOARD_ID=

DAYS_BACK=7
MIN_VIEWS=10000
MIN_RATIO=3.0
SUBSCRIBERS_FLOOR=1000
MAX_SEARCH_RESULTS_PER_KEYWORD=15
REPORT_TOP_N=5
LANGUAGE=ru
